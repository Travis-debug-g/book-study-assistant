# Mistral API (recommandé)
MISTRAL_API_KEY=your_mistral_api_key_here

# Ollama (gratuit, optionnel)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI (optionnel)
OPENAI_API_KEY=your_openai_api_key_here

# TTS (Text-to-Speech)
TTS_ENGINE=pyttsx3  # pyttsx3 (local, gratuit), gtts (gratuit), ou openai (payant)

# Anthropic (optionnel)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB
